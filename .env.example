# Server-side only. Never put this key in frontend files or Git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: keep unset to disable the admin cache endpoint.
CACHE_ADMIN_PASSWORD=
# Optional: defaults to ./cache. Render's ephemeral disk is sufficient for a cache.
# CACHE_DIR=/path/to/cache
# PORT=5001
